# Postgres connection string (required)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Public URL of the website, no trailing slash (used for canonical URLs, sitemap, Open Graph)
SITE_URL=https://your-domain.com

# Admin login (required for /admin). Use a long, unique password (10+ characters).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-long-unique-password
# Random string, at least 32 characters. Generate: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string-of-32-plus-characters

# Optional: where wallpaper files are stored (default ./content/wallpapers) and the import inbox (default ./content/inbox)
# WALLPAPER_STORAGE_DIR=/var/data/wallpapers
# WALLPAPER_INBOX_DIR=/var/data/inbox
# Optional: max upload size per file in MB (default 40)
# MAX_UPLOAD_MB=40

# Optional: contact form email delivery through Resend (https://resend.com).
# Messages are ALWAYS saved to the admin inbox; these add an email notification.
# RESEND_API_KEY=re_xxxxxxxxx
# CONTACT_TO_EMAIL=you@your-domain.com
# CONTACT_FROM_EMAIL="4K Wallpaper Of Me <contact@your-domain.com>"

# Optional: social links shown in the footer (only the ones you set are displayed)
# SOCIAL_INSTAGRAM=https://instagram.com/yourname
# SOCIAL_TIKTOK=https://tiktok.com/@yourname
# SOCIAL_YOUTUBE=https://youtube.com/@yourname
# SOCIAL_X=https://x.com/yourname
# SOCIAL_PINTEREST=https://pinterest.com/yourname
